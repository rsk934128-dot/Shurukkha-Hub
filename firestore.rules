rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isRole(role) {
      return isAuthenticated() && request.auth.token.role == role;
    }

    // SOS Signals: Citizens can create, Authorities can manage
    match /sos_alerts/{alertId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated();
      allow update: if isRole('authority') || isRole('admin');
      allow delete: if isRole('admin');
    }

    // Messages: Account to Account secure communication
    match /messages/{messageId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.senderId || 
        request.auth.uid == resource.data.recipientId || 
        resource.data.recipientId == 'command_center' ||
        isRole('authority') || 
        isRole('admin')
      );
      allow create: if isAuthenticated();
    }

    // Incident Reports: Public read, User/Authority write
    match /incidents/{incidentId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAuthenticated() && (isRole('admin') || request.auth.uid == resource.data.userId);
    }

    // Shelters: Public read, Admin write
    match /shelters/{shelterId} {
      allow read: if true;
      allow write: if isRole('admin');
    }

    // WebRTC Signaling: Private sessions between two parties
    match /webrtc_sessions/{sessionId} {
      allow read, write: if isAuthenticated();
      
      match /ice_candidates/{candidateId} {
        allow read, write: if isAuthenticated();
      }
    }

    // Audit Trails: Immutable logs
    match /audit_trails/{logId} {
      allow read: if isRole('admin');
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Suspect Profiles
    match /suspect_profiles/{profileId} {
      allow read: if isRole('admin') || isRole('authority');
      allow write: if isRole('admin');
    }
  }
}