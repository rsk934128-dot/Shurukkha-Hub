rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'rubels1k994@gmail.com' || 
        request.auth.token.email == 'rsk755734@gmail.com' || 
        request.auth.token.role == 'admin'
      );
    }
    
    function isRole(role) {
      return isAuthenticated() && request.auth.token.role == role;
    }

    // Users: Users can read/write their own profile, Admins can read all
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow list: if isAuthenticated();
    }

    // SOS Signals: Citizens can create, Authorities can manage
    match /sos_alerts/{alertId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Messages: Secured Account-to-Account communication via Fast-Track participants list
    match /messages/{messageId} {
      allow read: if isAuthenticated() && (
        request.auth.uid in resource.data.participants ||
        resource.data.recipientId == 'command_center' ||
        isAdmin()
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && request.auth.uid in resource.data.participants;
    }

    // WebRTC Signaling: Encrypted sessions
    match /webrtc_sessions/{sessionId} {
      allow read, write: if isAuthenticated();
      
      match /ice_candidates/{candidateId} {
        allow read, write: if isAuthenticated();
      }
    }

    // Incident Reports
    match /incidents/{incidentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (isAdmin() || request.auth.uid == resource.data.userId);
    }

    // Shelters, Domains, Integrations, Audit Trails
    match /shelters/{shelterId} { allow read: if true; allow write: if isAdmin(); }
    match /audit_trails/{logId} { allow read: if isAdmin(); allow create: if isAuthenticated(); }
    match /suspect_profiles/{profileId} { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /sovereign_domains/{domainId} { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /integrations/{integrationId} { allow read: if isAdmin() || isRole('authority'); allow write: if isAdmin(); }
    match /partner_requests/{requestId} { allow read: if isAdmin(); allow create: if true; }
  }
}