
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      let adminEmails = ['rubels1k994@gmail.com', 'rsk755734@gmail.com'];
      return isAuthenticated() && (
        request.auth.token.email in adminEmails || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isAuthority() {
      return isAuthenticated() && (
        isAdmin() || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'authority')
      );
    }

    // Users
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // Merchants
    match /merchants/{merchantId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // SOS Signals
    match /sos_alerts/{alertId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // External Notifications (Signal Hub)
    match /external_notifications/{notifId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
      allow create: if isAuthenticated();
    }

    // Integrations (Plugins / Apps)
    match /integrations/{appId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Standard collections
    match /audit_trails/{logId} { 
      allow read: if isAuthenticated(); // লগের স্বচ্ছতা সবার জন্য উন্মুক্ত (Read-Only)
      allow create: if isAuthenticated(); 
      allow delete: if isAdmin();
    }
    
    match /messages/{messageId} { allow read, write: if isAuthenticated(); }
    match /incidents/{incidentId} { allow read, write: if isAuthenticated(); }
    match /sovereign_domains/{domainId} { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /partner_requests/{requestId} { allow read: if isAuthority(); allow create: if isAuthenticated(); }
    match /relief_inventory/{itemId} { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /relief_distributions/{distId} { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /suspect_profiles/{profileId} { allow read: if isAuthority(); allow write: if isAdmin(); }
    
    match /webrtc_sessions/{sessionId} {
      allow read, write: if isAuthenticated();
      match /ice_candidates/{candidateId} {
        allow read, write: if isAuthenticated();
      }
    }
  }
}
