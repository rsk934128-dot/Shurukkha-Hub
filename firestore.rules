rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'rubels1k994@gmail.com' || 
        request.auth.token.email == 'rsk755734@gmail.com' || 
        request.auth.token.role == 'admin'
      );
    }
    
    function isRole(role) {
      return isAuthenticated() && request.auth.token.role == role;
    }

    // Users: Users can read/write their own profile, Admins can read all
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin() || isRole('authority');
    }

    // SOS Signals: Citizens can create, Authorities can manage
    match /sos_alerts/{alertId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated();
      allow update: if isRole('authority') || isAdmin();
      allow delete: if isAdmin();
    }

    // Messages: Account to Account secure communication
    match /messages/{messageId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.senderId || 
        request.auth.uid == resource.data.recipientId || 
        resource.data.recipientId == 'command_center' ||
        isRole('authority') || 
        isAdmin()
      );
      allow create: if isAuthenticated();
    }

    // Incident Reports: Public read, User/Authority write
    match /incidents/{incidentId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAuthenticated() && (isAdmin() || request.auth.uid == resource.data.userId);
    }

    // Shelters: Public read, Admin write
    match /shelters/{shelterId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // WebRTC Signaling: Private sessions between two parties
    match /webrtc_sessions/{sessionId} {
      allow read, write: if isAuthenticated();
      
      match /ice_candidates/{candidateId} {
        allow read, write: if isAuthenticated();
      }
    }

    // Audit Trails: Immutable logs
    match /audit_trails/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Suspect Profiles
    match /suspect_profiles/{profileId} {
      allow read: if isAdmin() || isRole('authority');
      allow write: if isAdmin();
    }
    
    // Sovereign Domains
    match /sovereign_domains/{domainId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Integrations
    match /integrations/{integrationId} {
      allow read: if isAdmin() || isRole('authority');
      allow write: if isAdmin();
    }
    
    // Partner Requests
    match /partner_requests/{requestId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }
  }
}