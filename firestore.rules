rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // SOS Signals: Anyone can create (even anonymous users for safety), but only responders can read
    match /sos_signals/{signalId} {
      allow create: if true;
      allow read, update: if isAuthenticated() && (
        request.auth.token.role == 'responder' || 
        request.auth.token.role == 'admin'
      );
      allow delete: if isAuthenticated() && request.auth.token.role == 'admin';
    }

    // Incidents: Citizens can create/read their own, responders/admins can manage
    match /incidents/{incidentId} {
      allow create: if true;
      allow read: if true; // Public awareness, but sensitive data can be filtered in UI
      allow update, delete: if isAuthenticated() && (
        request.auth.token.role == 'admin' || 
        request.auth.uid == resource.data.userId
      );
    }

    // Shelters: Publicly readable, only admins can update/delete
    match /shelters/{shelterId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.token.role == 'admin';
    }
  }
}