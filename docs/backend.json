
{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Extended user information and role assignments.",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "photoURL": { "type": "string" },
        "role": { 
          "type": "string", 
          "enum": ["citizen", "authority", "admin"],
          "default": "citizen"
        },
        "phoneNumber": { "type": "string" },
        "lastLogin": { "type": "string", "format": "date-time" },
        "twoFactorEnabled": { "type": "boolean", "default": false },
        "twoFactorSecret": { "type": "string", "description": "Encrypted TOTP Secret" },
        "recoveryCodes": { "type": "array", "items": { "type": "string" } },
        "deviceFingerprint": { "type": "string" }
      },
      "required": ["role"]
    },
    "MerchantProfile": {
      "title": "Sovereign Merchant",
      "description": "Registered businesses integrated with SovereignPay.",
      "type": "object",
      "properties": {
        "businessName": { "type": "string" },
        "ownerName": { "type": "string" },
        "category": { "type": "string", "enum": ["Textile", "Grocery", "Service", "Emergency", "Other"] },
        "merchantId": { "type": "string", "description": "SMID-XXXX format" },
        "apiKey": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "pending", "suspended"] },
        "totalRevenue": { "type": "number", "default": 0 },
        "taxCollected": { "type": "number", "default": 0 },
        "onboardedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["businessName", "merchantId", "status"]
    },
    "SOSAlert": {
      "title": "SOS Alert",
      "description": "Emergency distress signal with status, assigned responder, and incident timeline.",
      "type": "object",
      "properties": {
        "reporterId": { "type": "string" },
        "location": { "type": "string" },
        "status": { 
          "type": "string", 
          "enum": ["pending", "dispatched", "arrived", "resolved"] 
        },
        "timestamp": { "type": "string", "format": "date-time" },
        "type": { "type": "string" },
        "assignedResponder": { "type": "string" },
        "timeline": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "status": { "type": "string" },
              "note": { "type": "string" },
              "timestamp": { "type": "string", "format": "date-time" },
              "automated": { "type": "boolean" }
            }
          }
        }
      },
      "required": ["status", "timestamp", "location"]
    }
  },
  "auth": {
    "providers": ["google.com", "phone"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Storage for user identity and role data."
    },
    "/merchants/{merchantId}": {
      "schema": "MerchantProfile",
      "description": "Registry for onboarded businesses."
    },
    "/sos_alerts/{alertId}": {
      "schema": "SOSAlert",
      "description": "Active emergency distress signals with forensic timeline."
    }
  }
}
