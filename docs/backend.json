{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Extended user information and role assignments.",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "photoURL": { "type": "string" },
        "role": { 
          "type": "string", 
          "enum": ["citizen", "authority", "admin"],
          "default": "citizen"
        },
        "phoneNumber": { "type": "string" },
        "lastLogin": { "type": "string", "format": "date-time" },
        "twoFactorEnabled": { "type": "boolean", "default": false },
        "twoFactorSecret": { "type": "string", "description": "Encrypted TOTP Secret" },
        "recoveryCodes": { "type": "array", "items": { "type": "string" } },
        "deviceFingerprint": { "type": "string" }
      },
      "required": ["role"]
    },
    "SOSAlert": {
      "title": "SOS Alert",
      "description": "Emergency distress signal with status, assigned responder, and incident timeline.",
      "type": "object",
      "properties": {
        "reporterId": { "type": "string" },
        "location": { "type": "string" },
        "status": { 
          "type": "string", 
          "enum": ["pending", "dispatched", "arrived", "resolved"] 
        },
        "timestamp": { "type": "string", "format": "date-time" },
        "type": { "type": "string" },
        "assignedResponder": { "type": "string" },
        "timeline": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "status": { "type": "string" },
              "note": { "type": "string" },
              "timestamp": { "type": "string", "format": "date-time" },
              "automated": { "type": "boolean" }
            }
          }
        }
      },
      "required": ["status", "timestamp", "location"]
    },
    "Message": {
      "title": "Secure Message",
      "description": "Encrypted communication between nodes.",
      "type": "object",
      "properties": {
        "senderId": { "type": "string" },
        "recipientId": { "type": "string" },
        "content": { "type": "string" },
        "type": { "type": "string", "enum": ["text", "file", "voice"] },
        "timestamp": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["sent", "delivered", "read", "queued"] },
        "fileUrl": { "type": "string" },
        "isEncrypted": { "type": "boolean" }
      },
      "required": ["senderId", "recipientId", "content", "timestamp"]
    }
  },
  "auth": {
    "providers": ["google.com", "phone"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Storage for user identity and role data."
    },
    "/sos_alerts/{alertId}": {
      "schema": "SOSAlert",
      "description": "Active emergency distress signals with forensic timeline."
    },
    "/messages/{messageId}": {
      "schema": "Message",
      "description": "Secure account-to-account communication logs."
    },
    "/incidents/{incidentId}": {
      "schema": "object",
      "description": "Public and private incident reports with forensic evidence."
    },
    "/audit_trails/{logId}": {
      "schema": "object",
      "description": "Immutable registry of security and system events."
    }
  }
}