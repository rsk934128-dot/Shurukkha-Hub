
{
  "entities": {
    "SOSAlert": {
      "title": "SOS Alert",
      "description": "Emergency distress signal with status, assigned responder, and incident timeline.",
      "type": "object",
      "properties": {
        "reporterId": { "type": "string" },
        "location": { "type": "string" },
        "status": { 
          "type": "string", 
          "enum": ["pending", "dispatched", "arrived", "resolved"] 
        },
        "timestamp": { "type": "string", "format": "date-time" },
        "type": { "type": "string" },
        "assignedResponder": { "type": "string" },
        "timeline": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "status": { "type": "string" },
              "note": { "type": "string" },
              "timestamp": { "type": "string", "format": "date-time" },
              "automated": { "type": "boolean" }
            }
          }
        }
      },
      "required": ["status", "timestamp", "location"]
    },
    "Responder": {
      "title": "Emergency Responder",
      "description": "Information about available emergency teams.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["Police", "Fire", "Medical", "Volunteer"] },
        "status": { "type": "string", "enum": ["available", "busy"] },
        "currentLocation": { "type": "string" }
      }
    },
    "IntegrationApp": {
      "title": "Third-party Integration",
      "description": "External apps authorized to consume Shurukkha Hub events.",
      "type": "object",
      "properties": {
        "appName": { "type": "string" },
        "apiKey": { "type": "string" },
        "webhookUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "revoked"] },
        "subscribedEvents": { 
          "type": "array", 
          "items": { "type": "string" } 
        },
        "partnershipLevel": { "type": "string", "enum": ["Standard", "Imperial", "Sovereign"] }
      }
    },
    "SovereignDomain": {
      "title": "Sovereign Domain",
      "description": "Private DNS records for the sovereign infrastructure.",
      "type": "object",
      "properties": {
        "domainName": { "type": "string" },
        "extension": { "type": "string", "enum": [".sheikh", ".surukkha", ".imperial"] },
        "targetIp": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "propagating", "locked"] },
        "dnsType": { "type": "string", "enum": ["A", "CNAME", "SOA"] },
        "lastResolved": { "type": "string", "format": "date-time" }
      }
    },
    "SovereignHandshake": {
      "title": "Sovereign Handshake",
      "description": "Records of secure digital handshakes with NoorAI/FusionPay.",
      "type": "object",
      "properties": {
        "transactionId": { "type": "string" },
        "action": { "type": "string" },
        "status": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "SuspectProfile": {
      "title": "Suspect Profile",
      "description": "Captured intelligence on potential attackers identified by the Guard Engine.",
      "type": "object",
      "properties": {
        "ipAddress": { "type": "string" },
        "userAgent": { "type": "string" },
        "threatLevel": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        "violationCount": { "type": "number" },
        "lastIncident": { "type": "string", "format": "date-time" },
        "capturedAt": { "type": "string", "enum": ["gatekeeper", "honeypot", "deep_inspection"] },
        "status": { "type": "string", "enum": ["monitored", "blacklisted"] }
      }
    }
  },
  "auth": {
    "providers": ["google.com", "phone"]
  },
  "firestore": {
    "/sos_alerts/{alertId}": {
      "schema": "SOSAlert",
      "description": "Active emergency distress signals with forensic timeline."
    },
    "/responders/{responderId}": {
      "schema": "Responder",
      "description": "Directory of emergency response teams."
    },
    "/integrations/{appId}": {
      "schema": "IntegrationApp",
      "description": "Registry of authorized partner applications."
    },
    "/sovereign_domains/{domainId}": {
      "schema": "SovereignDomain",
      "description": "Private DNS records for the sovereign network."
    },
    "/suspect_profiles/{profileId}": {
      "schema": "SuspectProfile",
      "description": "Captured threat intelligence log."
    }
  }
}
