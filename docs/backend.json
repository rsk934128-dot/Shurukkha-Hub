
{
  "entities": {
    "SOSAlert": {
      "title": "SOS Alert",
      "description": "Emergency distress signal with status and assigned responder.",
      "type": "object",
      "properties": {
        "reporterId": { "type": "string" },
        "location": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "dispatched", "resolved"] },
        "timestamp": { "type": "string", "format": "date-time" },
        "type": { "type": "string" },
        "assignedResponder": { "type": "string" }
      },
      "required": ["status", "timestamp", "location"]
    },
    "Responder": {
      "title": "Emergency Responder",
      "description": "Information about available emergency teams.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["Police", "Fire", "Medical", "Volunteer"] },
        "status": { "type": "string", "enum": ["available", "busy"] },
        "currentLocation": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["google.com", "phone"]
  },
  "firestore": {
    "/sos_alerts/{alertId}": {
      "schema": "SOSAlert",
      "description": "Active emergency distress signals."
    },
    "/responders/{responderId}": {
      "schema": "Responder",
      "description": "Directory of emergency response teams."
    }
  }
}
