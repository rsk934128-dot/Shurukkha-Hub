
{
  "entities": {
    "SOSAlert": {
      "title": "SOS Alert",
      "description": "Emergency distress signal with status, assigned responder, and incident timeline.",
      "type": "object",
      "properties": {
        "reporterId": { "type": "string" },
        "location": { "type": "string" },
        "status": { 
          "type": "string", 
          "enum": ["pending", "dispatched", "arrived", "resolved"] 
        },
        "timestamp": { "type": "string", "format": "date-time" },
        "type": { "type": "string" },
        "assignedResponder": { "type": "string" },
        "timeline": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "status": { "type": "string" },
              "note": { "type": "string" },
              "timestamp": { "type": "string", "format": "date-time" },
              "automated": { "type": "boolean" }
            }
          }
        }
      },
      "required": ["status", "timestamp", "location"]
    },
    "Responder": {
      "title": "Emergency Responder",
      "description": "Information about available emergency teams.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["Police", "Fire", "Medical", "Volunteer"] },
        "status": { "type": "string", "enum": ["available", "busy"] },
        "currentLocation": { "type": "string" }
      }
    },
    "IntegrationApp": {
      "title": "Third-party Integration",
      "description": "External apps authorized to consume Shurukkha Hub events.",
      "type": "object",
      "properties": {
        "appName": { "type": "string" },
        "apiKey": { "type": "string" },
        "webhookUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "revoked"] },
        "subscribedEvents": { 
          "type": "array", 
          "items": { "type": "string" } 
        },
        "partnershipLevel": { "type": "string", "enum": ["Standard", "Imperial", "Sovereign"] }
      }
    },
    "SovereignHandshake": {
      "title": "Sovereign Handshake",
      "description": "Records of secure digital handshakes with NoorAI/FusionPay.",
      "type": "object",
      "properties": {
        "transactionId": { "type": "string" },
        "action": { "type": "string" },
        "status": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "BankRegistry": {
      "title": "Global Bank Registry",
      "description": "Directory of international banking nodes connected via Stripe.",
      "type": "object",
      "properties": {
        "country": { "type": "string" },
        "bankName": { "type": "string" },
        "status": { "type": "string" },
        "handshakeId": { "type": "string" },
        "pushAvailable": { "type": "boolean" }
      }
    },
    "LocalSettlement": {
      "title": "Local Payment Settlement",
      "description": "Records of mobile finance settlements (bKash, Nagad).",
      "type": "object",
      "properties": {
        "settlementId": { "type": "string" },
        "amount": { "type": "number" },
        "currency": { "type": "string" },
        "target": { "type": "string" },
        "status": { "type": "string" },
        "signature": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["google.com", "phone"]
  },
  "firestore": {
    "/sos_alerts/{alertId}": {
      "schema": "SOSAlert",
      "description": "Active emergency distress signals with forensic timeline."
    },
    "/responders/{responderId}": {
      "schema": "Responder",
      "description": "Directory of emergency response teams."
    },
    "/integrations/{appId}": {
      "schema": "IntegrationApp",
      "description": "Registry of authorized partner applications."
    },
    "/sovereign_handshakes/{handshakeId}": {
      "schema": "SovereignHandshake",
      "description": "Audit log of NoorAI/FusionPay handshakes."
    },
    "/bank_registry/{bankId}": {
      "schema": "BankRegistry",
      "description": "Directory of global banking nodes."
    },
    "/local_settlements/{settlementId}": {
      "schema": "LocalSettlement",
      "description": "Records of bKash/Mobile finance settlements."
    }
  }
}
